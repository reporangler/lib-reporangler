{
    "name": "reporangler/lib-reporangler",
    "description": "A Lumen library that provides access to the RepoRangler REST api",
    "keywords": ["reporangler", "php", "laravel"],
    "license": "MIT",
    "type": "library",
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/reporangler/lib-reporangler"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^6.3|^7.0"
    },
    "require-dev": {
        "laravel/framework": "^11.0",
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "RepoRangler\\": "src/RepoRangler/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
